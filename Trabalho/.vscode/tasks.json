{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build project",
            "command": "g++.exe",
            "args": [
                "-g",
                "${workspaceFolder}/main.cpp",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/build/main"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}